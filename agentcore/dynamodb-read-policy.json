{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-2:374894298498:table/deanza-class-schedule",
        "arn:aws:dynamodb:us-west-2:374894298498:table/deanza-pathway-conflicts",
        "arn:aws:dynamodb:us-west-2:374894298498:table/deanza-pathways-normalized",
        "arn:aws:dynamodb:us-west-2:374894298498:table/deanza-class-schedule/index/*",
        "arn:aws:dynamodb:us-west-2:374894298498:table/deanza-pathway-conflicts/index/*"
      ]
    }
  ]
}
